{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccvv.local/schemas/profile.schema.json",
  "title": "Profile Data",
  "description": "Schema for profiles/[id]/data/profile.json - Individual profile data",
  "type": "object",
  "required": ["metadata", "info", "languages", "interests", "skills", "knowledge", "experience", "education", "projects"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "profile", "file", "created", "updated"],
      "properties": {
        "version": {
          "type": "number",
          "description": "Profile data version",
          "minimum": 1.0
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9_]{3,20}$",
          "description": "Profile ID"
        },
        "file": {
          "type": "string",
          "description": "Source file path (relative to profile directory)"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (ISO 8601)"
        },
        "updated": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp (ISO 8601)"
        }
      },
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "required": ["name", "titles", "contact"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "titles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "photo": {
          "type": ["string", "null"],
          "description": "Filename of the profile photo stored in the profile input/ directory (e.g. 'photo.jpg'). Null if no photo was provided."
        },
        "contact": {
          "type": "object",
          "required": ["email", "phone", "location"],
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "others": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "required": ["type", "value"],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Contact type (linkedin, github, twitter, website, etc.)"
                  },
                  "value": {
                    "type": "string",
                    "description": "Contact value"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["language", "level"],
        "properties": {
          "language": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": ["native", "fluent", "intermediate", "basic"]
          }
        }
      }
    },
    "interests": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "knowledge": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["category", "key", "values"],
        "properties": {
          "category": {
            "type": "string",
            "description": "Human-readable category name"
          },
          "key": {
            "type": "string",
            "description": "Machine-readable key for programmatic access"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "experience": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["position", "company", "location", "description"],
        "properties": {
          "position": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "period": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "achievements": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "team_size": {
            "type": ["string", "null"]
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["type", "category", "title"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["education", "course", "certification", "grade"]
          },
          "category": {
            "type": "string",
            "enum": ["education", "related", "others"]
          },
          "title": {
            "type": "string"
          },
          "institution": {
            "type": ["string", "null"]
          },
          "location": {
            "type": ["string", "null"]
          },
          "status": {
            "type": ["string", "null"]
          },
          "period": {
            "type": ["object", "null"],
            "properties": {
              "date": {
                "type": ["string", "null"]
              },
              "duration": {
                "type": ["integer", "null"]
              },
              "duration_unit": {
                "type": ["string", "null"],
                "enum": ["hours", "days", "months", "years", null]
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["type", "name", "description"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["professional", "personal"]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["completed", "in_development", "on_hold", "cancelled", null]
          },
          "url": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri"
              },
              "demo": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
